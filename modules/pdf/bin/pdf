#!/bin/bash
# office-kit pdf — Stirling-PDF 离线后端封装
# 入口只负责定位目录、导出环境变量，然后把参数原样交给 Python 实现。
set -u

_self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
_BIN="$(cd "$(dirname "$_self")" && pwd)"
_MODULE="$(cd "$_BIN/.." && pwd)"
_ROOT="${OFFICE_KIT_ROOT:-$(cd "$_MODULE/../.." && pwd)}"
_RUNTIME="${OFFICE_KIT_RUNTIME:-${_ROOT}/runtime}"

# 与 bin/office-kit 保持一致的回退逻辑（模块被单独执行时也可用）
: "${OFFICE_KIT_DATA:=${XDG_DATA_HOME:-${HOME}/.local/share}/office-kit}"
: "${OFFICE_KIT_CACHE:=${OFFICE_KIT_DATA}/cache}"
: "${OFFICE_KIT_LOGS:=${OFFICE_KIT_DATA}/logs}"
: "${OFFICE_KIT_LANG:=zh_CN}"
: "${OFFICE_KIT_PY:=${_RUNTIME}/python/bin/python3}"
: "${OFFICE_KIT_JAVA:=${_RUNTIME}/jre/bin/java}"
: "${OFFICE_KIT_STIRLING:=${_RUNTIME}/stirling}"

export OFFICE_KIT_ROOT="${_ROOT}"
export OFFICE_KIT_RUNTIME="${_RUNTIME}"
export OFFICE_KIT_DATA OFFICE_KIT_CACHE OFFICE_KIT_LOGS OFFICE_KIT_LANG
export OFFICE_KIT_PY OFFICE_KIT_JAVA OFFICE_KIT_STIRLING
# 供实现模块定位自身资源（lib/icc、lib/gs 等）
export OFFICE_KIT_PDF_MODULE="${_MODULE}"

if [ ! -x "${OFFICE_KIT_PY}" ]; then
  echo "pdf: 缺少 Python 运行时：${OFFICE_KIT_PY}" >&2
  echo "修复：确认 runtime/python 已就位，或设置 OFFICE_KIT_PY 指向 python3。" >&2
  exit 3
fi

# PyMuPDF 等模块私有 Python 依赖（若 test.sh / 辅助脚本需要）
if [ -d "${_MODULE}/lib/py" ]; then
  export PYTHONPATH="${_MODULE}/lib/py${PYTHONPATH:+:${PYTHONPATH}}"
fi

exec "${OFFICE_KIT_PY}" "${_MODULE}/lib/pdfkit.py" "$@"
